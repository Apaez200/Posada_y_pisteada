# Copia este archivo como ".env" y llena los valores. El archivo .env NO se sube a git.
TANDA_ADMIN_EMAIL=tu@correo.com
TANDA_ADMIN_PASS=pon-aqui-una-contraseña-larga

# Puerto en el servidor (opcional)
TANDA_PORT=5000

# Pon 1 cuando el sitio use HTTPS (cookie de sesión segura)
TANDA_PROD=0

# Proxies de confianza delante del contenedor (Nginx/Caddy/Traefik = 1). Sin proxy = 0
TANDA_PROXY=0
